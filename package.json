{
  "name": "deliverly",
  "private": true,
  "scripts": {
    "build": "react-router build",
    "dev": "shopify app dev --config development",
    "dev:reset": "shopify app dev --reset",
    "config:link": "shopify app config link",
    "generate": "shopify app generate",
    "build:storefront": "esbuild storefront/deliverly-eta.js --minify --legal-comments=none --banner:js=\"/* Built from storefront/deliverly-eta.js by pnpm build:storefront. Don't edit. */\" --outfile=extensions/deliverly-eta/assets/deliverly-eta.js",
    "deploy": "pnpm build:storefront && shopify app deploy --config shopify.app.toml",
    "config:use": "shopify app config use",
    "env": "shopify app env",
    "preview": "react-router build && vite preview",
    "deploy:worker": "react-router build && wrangler deploy",
    "cf-typegen": "wrangler types",
    "db:migrate:local": "wrangler d1 migrations apply deliverly --local",
    "db:migrate:remote": "wrangler d1 migrations apply deliverly --remote",
    "setup": "prisma generate",
    "lint": "eslint --ignore-path .gitignore --cache --cache-location ./node_modules/.cache/eslint .",
    "shopify": "shopify",
    "prisma": "prisma",
    "vite": "vite",
    "typecheck": "react-router typegen && tsc --noEmit",
    "test": "vitest run"
  },
  "type": "module",
  "packageManager": "pnpm@11.24.0",
  "engines": {
    "node": ">=22.12"
  },
  "dependencies": {
    "@prisma/adapter-d1": "6.19.3",
    "@prisma/client": "^6.19.0",
    "@react-router/dev": "7.18.2",
    "@react-router/fs-routes": "7.18.2",
    "@react-router/node": "7.18.2",
    "@shopify/app-bridge-react": "^4.2.4",
    "@shopify/shopify-app-react-router": "^2.1.0",
    "@shopify/shopify-app-session-storage-prisma": "^10.0.1",
    "isbot": "^5.1.31",
    "prisma": "^6.19.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router": "7.18.2",
    "vite-tsconfig-paths": "^5.1.4"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.63.1",
    "@shopify/polaris-types": "^2.0.0-rc.3",
    "@types/eslint": "^9.6.1",
    "@types/node": "^22.18.8",
    "@types/react": "^18.3.25",
    "@types/react-dom": "^18.3.7",
    "@typescript-eslint/eslint-plugin": "^6.21.0",
    "@typescript-eslint/parser": "^6.21.0",
    "eslint": "^8.57.1",
    "eslint-import-resolver-typescript": "^3.10.1",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^4.6.2",
    "prettier": "^3.6.2",
    "typescript": "^5.9.3",
    "vite": "^6.3.6",
    "vitest": "^3.2.7",
    "wrangler": "^4.149.0"
  },
  "workspaces": [
    "extensions/*"
  ],
  "trustedDependencies": [
    "@shopify/plugin-cloudflare"
  ],
  "overrides": {
    "p-map": "^4.0.0",
    "qs": "^6.16.0"
  },
  "author": "peermohammad"
}