// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
  // On Cloudflare Workers queries go through @prisma/adapter-pg
  // (see app/db.server.ts); the native engine can't run there.
}

// Note that some adapters may set a maximum length for the String type by default, please ensure your strings are long
// enough when changing adapters.
// See https://www.prisma.io/docs/orm/reference/prisma-schema-reference#string for more information
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Session {
  id                  String    @id
  shop                String
  state               String
  isOnline            Boolean   @default(false)
  scope               String?
  expires             DateTime?
  accessToken         String
  userId              BigInt?
  firstName           String?
  lastName            String?
  email               String?
  accountOwner        Boolean   @default(false)
  locale              String?
  collaborator        Boolean?  @default(false)
  emailVerified       Boolean?  @default(false)
  refreshToken        String?
  refreshTokenExpires DateTime?
}

model DeliveryRule {
  id              String       @id @default(cuid())
  shop            String
  defaultShopKey  String?      @unique
  name            String
  type            RuleType
  minDeliveryDays Int
  maxDeliveryDays Int
  processingDays  Int
  excludedDays    String
  customMessage   String
  enabled         Boolean      @default(true)
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  targets         RuleTarget[]

  @@index([shop])
  @@index([shop, type])
}

/// Store-wide settings, one row per shop.
model ShopSettings {
  shop          String   @id
  /// Order cutoff in minutes after midnight, in the shop's time zone.
  /// null = no cutoff. Applies to every rule.
  cutoffMinutes Int?
  updatedAt     DateTime @updatedAt
}

model RuleTarget {
  id         String       @id @default(cuid())
  ruleId     String
  targetType TargetType
  targetId   String
  rule       DeliveryRule @relation(fields: [ruleId], references: [id], onDelete: Cascade)

  @@unique([ruleId, targetType, targetId])
  @@index([targetType, targetId])
  @@index([ruleId])
}

enum RuleType {
  DEFAULT
  PRODUCT
  COLLECTION
}

enum TargetType {
  PRODUCT
  COLLECTION
}
