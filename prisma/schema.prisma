// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
  // On Cloudflare Workers queries go through @prisma/adapter-d1
  // (see app/db.server.ts); the native engine can't run there.
}

// Note that some adapters may set a maximum length for the String type by default, please ensure your strings are long
// enough when changing adapters.
// See https://www.prisma.io/docs/orm/reference/prisma-schema-reference#string for more information
// The app's database is Cloudflare D1 (SQLite), reached through the DB
// binding in wrangler.jsonc. This url is only for the Prisma CLI, which
// generates the client and migration SQL; it never touches D1.
datasource db {
  provider = "sqlite"
  url      = "file:./dev.sqlite"
}

model Session {
  id                  String    @id
  shop                String
  state               String
  isOnline            Boolean   @default(false)
  scope               String?
  expires             DateTime?
  accessToken         String
  userId              BigInt?
  firstName           String?
  lastName            String?
  email               String?
  accountOwner        Boolean   @default(false)
  locale              String?
  collaborator        Boolean?  @default(false)
  emailVerified       Boolean?  @default(false)
  refreshToken        String?
  refreshTokenExpires DateTime?
}

model DeliveryRule {
  id              String       @id @default(cuid())
  shop            String
  // Set to the shop only on its all-countries DEFAULT rule, so the unique
  // index allows one of those per shop. Country DEFAULT rules leave it null.
  defaultShopKey  String?      @unique
  name            String
  type            RuleType
  minDeliveryDays Int
  maxDeliveryDays Int
  processingDays  Int
  excludedDays    String
  // Order cutoff in minutes after midnight, in the shop's time zone.
  // null = no cutoff.
  cutoffMinutes   Int?
  // ISO country codes, comma-separated and sorted ("DE,FR").
  // "" = all countries.
  countries       String       @default("")
  customMessage   String
  enabled         Boolean      @default(true)
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  targets         RuleTarget[]

  @@index([shop])
  @@index([shop, type])
}

model RuleTarget {
  id         String       @id @default(cuid())
  ruleId     String
  targetType TargetType
  targetId   String
  rule       DeliveryRule @relation(fields: [ruleId], references: [id], onDelete: Cascade)

  @@unique([ruleId, targetType, targetId])
  @@index([targetType, targetId])
  @@index([ruleId])
}

enum RuleType {
  DEFAULT
  PRODUCT
  COLLECTION
}

enum TargetType {
  PRODUCT
  COLLECTION
}

/// Sync state of a shop's storefront config metafield ($app /
/// deliverly_config). Out of date while syncedAt is null or older than
/// requestedAt; the admin then shows a banner with a retry.
model StorefrontSync {
  shop        String    @id
  /// Last time a change asked for a sync.
  requestedAt DateTime  @default(now())
  /// Start time of the newest sync that reached Shopify.
  syncedAt    DateTime?
  /// Time zone in the last written config, to spot shop/update changes.
  timezone    String?
  /// "TOO_LARGE" or the last failure's message; null after a success.
  lastError   String?
  updatedAt   DateTime  @updatedAt
}
