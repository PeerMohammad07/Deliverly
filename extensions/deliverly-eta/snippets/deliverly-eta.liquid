{% comment %}
  Deliverly estimated delivery — single source of truth for the ETA UI.
  Rendered once by blocks/app-embed.liquid as an inert template (nothing
  visible). assets/deliverly-eta.js clones it into the product area, then
  replaces the message with the real storefront estimate response.
{% endcomment %}
<style>
  .deliverly-eta {
    margin: 1rem 0;
    font: inherit;
    font-size: 0.95em;
    line-height: 1.5;
    color: inherit;
    text-align: inherit;
  }
  .deliverly-eta[hidden] {
    display: none;
  }
  .deliverly-eta__row {
    min-width: 0;
  }
  .deliverly-eta__label {
    display: block;
    margin-bottom: 0.125rem;
    font-size: 0.85em;
    opacity: 0.7;
  }
  .deliverly-eta__dates {
    display: block;
    font-weight: 600;
    overflow-wrap: anywhere;
    word-break: break-word;
  }
</style>

<template data-deliverly-eta-template>
  <div class="deliverly-eta" data-deliverly-eta-state="loading" hidden>
    <div class="deliverly-eta__row">
      <div>
        <span class="deliverly-eta__label">Estimated delivery</span>
        <span class="deliverly-eta__dates" data-deliverly-eta-dates></span>
      </div>
    </div>
  </div>
</template>
