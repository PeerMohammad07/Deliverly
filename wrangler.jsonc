{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "deliverly",
  "main": "./worker/app.ts",
  "compatibility_date": "2026-10-01",
  // nodejs_compat: AsyncLocalStorage (per-request database client). It
  // also fills process.env from vars and secrets, which
  // app/shopify.server.ts reads.
  "compatibility_flags": ["nodejs_compat"],
  // Public at https://deliverly.peeru548.workers.dev; no per-version
  // preview URLs.
  "workers_dev": true,
  "preview_urls": false,
  // App database (Cloudflare D1, SQLite). Migrations live in
  // prisma/d1-migrations and are applied with `wrangler d1 migrations apply`.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "deliverly",
      "database_id": "56da22ca-0709-4eb3-a855-036476a013bd",
      "migrations_dir": "prisma/d1-migrations"
    }
  ],
  // Short-lived cache of Shopify lookups for storefront estimates
  // (product collections and shop time zone).
  "kv_namespaces": [
    {
      "binding": "CACHE",
      "id": "d4b2f99eef0d47989a9b6e68746413d0"
    }
  ],
  "observability": {
    "enabled": true
  }
  // Secrets (set with `wrangler secret put <NAME>` or in the dashboard;
  // locally Shopify CLI provides them, see vite.config.ts):
  //   SHOPIFY_API_KEY, SHOPIFY_API_SECRET, SHOPIFY_APP_URL, SCOPES
  //   optional: SHOPIFY_APP_HANDLE, SHOP_CUSTOM_DOMAIN
}
